{
	"$schema": "https://turbo.build/schema.json",
	"agentGuidance": false,
	"tasks": {
		"topo": {
			"dependsOn": ["^topo"]
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "README.md"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"lint": {
			"dependsOn": ["topo"],
			"outputs": ["node_modules/.cache/.eslintcache"],
			"outputLogs": "new-only"
		},
		"format": {
			"dependsOn": ["topo"],
			"outputLogs": "new-only"
		}
	},
	"ui": "stream"
}

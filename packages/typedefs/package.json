{
	"name": "@labdigital/graphql-codegen-typedefs",
	"version": "0.1.1",
	"description": "Generate a typedefs file with your GraphQL schema",
	"type": "module",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"keywords": [
		"graphql",
		"codegen"
	],
	"author": "Lab Digital <opensource@labdigital.nl>",
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/labd/graphql-codegen-plugins.git",
		"directory": "packages/typedefs"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"test:ci": "vitest run --coverage",
		"typecheck": "tsc --noEmit"
	},
	"files": [
		"dist",
		"src"
	],
	"dependencies": {
		"@graphql-tools/utils": "12.0.3"
	},
	"devDependencies": {
		"graphql": "^17.0.2",
		"publint": "^0.3.25",
		"tsdown": "^0.23.1",
		"typescript": "^7.0.2",
		"vitest": "5.0.3"
	},
	"peerDependencies": {
		"graphql": "^16.0.0 || ^17.0.0"
	}
}

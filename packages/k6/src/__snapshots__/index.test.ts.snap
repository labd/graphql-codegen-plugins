      return {
            GetProduct(variables: GetProductQueryVariables, options?: C): RefinedResponse<ResponseType> {
              return requester<GetProductQuery, GetProductQueryVariables>(Operations.GetProductDocument, variables, options);
            },
    ListProducts(variables?: ListProductsQueryVariables, options?: C): RefinedResponse<ResponseType> {
              return requester<ListProductsQuery, ListProductsQueryVariables>(Operations.ListProductsDocument, variables, options);
            },
    AddToCart(variables: AddToCartMutationVariables, options?: C): RefinedResponse<ResponseType> {
              return requester<AddToCartMutation, AddToCartMutationVariables>(Operations.AddToCartDocument, variables, options);
            },
    CartUpdated(variables: CartUpdatedSubscriptionVariables, options?: C): RefinedResponse<ResponseType> {
              return requester<CartUpdatedSubscription, CartUpdatedSubscriptionVariables>(Operations.CartUpdatedDocument, variables, options);
            }
      };
    }
    export type Sdk = ReturnType<typeof getSdk>;"
`;

exports[`k6 plugin > documentMode graphQLTag (useTypeImports: false) > generates the sdk 1`] = `
"import { type RefinedResponse, type ResponseType } from "k6/http";
import gql from 'graphql-tag';
import { DocumentNode } from 'graphql';
export const ProductPriceFragmentDoc = gql\`
    fragment ProductPrice on Product {
  price
}
    \`;
export const ProductFieldsFragmentDoc = gql\`
    fragment ProductFields on Product {
  id
  name
  ...ProductPrice
}
    \`;
export const GetProductDocument = gql\`
    query GetProduct($id: ID!, $locale: Locale) {
  product(id: $id, locale: $locale) {
    ...ProductFields
  }
}
    \${ProductFieldsFragmentDoc}
\${ProductPriceFragmentDoc}\`;
export const ListProductsDocument = gql\`
    query ListProducts($filter: ProductFilter) {
  products(filter: $filter) {
    ...ProductFields
  }
}
    \${ProductFieldsFragmentDoc}
\${ProductPriceFragmentDoc}\`;
export const AddToCartDocument = gql\`
    mutation AddToCart($productId: ID!, $quantity: Int!) {
  addToCart(productId: $productId, quantity: $quantity) {
    id
    totalItems
  }
}
    \`;
export const CartUpdatedDocument = gql\`
    subscription CartUpdated($cartId: ID!) {
  cartUpdated(cartId: $cartId) {
    id
  }
}
    \`;

    export type Requester<C = {}, E = unknown> = <R, V>(doc: DocumentNode, vars?: V, options?: C) => RefinedResponse<ResponseType>

    export function getSdk<C, E>(requester: Requester<C, E>) {
      return {
            GetProduct(variables: GetProductQueryVariables, options?: C): RefinedResponse<ResponseType> {
              return requester<GetProductQuery, GetProductQueryVariables>(GetProductDocument, variables, options);
            },
    ListProducts(variables?: ListProductsQueryVariables, options?: C): RefinedResponse<ResponseType> {
              return requester<ListProductsQuery, ListProductsQueryVariables>(ListProductsDocument, variables, options);
            },
    AddToCart(variables: AddToCartMutationVariables, options?: C): RefinedResponse<ResponseType> {
              return requester<AddToCartMutation, AddToCartMutationVariables>(AddToCartDocument, variables, options);
            },
    CartUpdated(variables: CartUpdatedSubscriptionVariables, options?: C): RefinedResponse<ResponseType> {
              return requester<CartUpdatedSubscription, CartUpdatedSubscriptionVariables>(CartUpdatedDocument, variables, options);
            }
      };
    }
    export type Sdk = ReturnType<typeof getSdk>;"
`;


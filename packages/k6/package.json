{
	"name": "@labdigital/graphql-codegen-k6",
	"version": "0.1.1",
	"type": "module",
	"types": "./dist/index.d.ts",
	"description": "GraphQL Code Generator plugin for generating a ready-to-use k6 compatible SDK based on GraphQL operations",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/labd/graphql-codegen-plugins.git",
		"directory": "packages/k6"
	},
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"publish:ci": "pnpm build && pnpm changeset publish",
		"test": "vitest run",
		"test:ci": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@graphql-codegen/plugin-helpers": "^7.4.2",
		"@graphql-codegen/visitor-plugin-common": "7.2.10",
		"auto-bind": "5.0.1"
	},
	"devDependencies": {
		"@graphql-codegen/typescript-operations": "^6.1.10",
		"@types/k6": "^2.3.0",
		"@types/node": "^26.6.5",
		"graphql": "^17.0.2",
		"graphql-tag": "^2.0.0",
		"publint": "^0.3.25",
		"tsdown": "^0.23.1",
		"tslib": "2.8.1",
		"typescript": "^7.0.2",
		"vitest": "5.0.3"
	},
	"peerDependencies": {
		"graphql": "^16.0.0 || ^17.0.0",
		"graphql-tag": "^2.0.0"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}

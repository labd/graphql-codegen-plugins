{
	"name": "@labdigital/graphql-codegen-k6",
	"version": "0.1.1",
	"type": "module",
	"types": "./dist/index.d.ts",
	"description": "GraphQL Code Generator plugin for generating a ready-to-use k6 compatible SDK based on GraphQL operations",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/labd/graphql-codegen-plugins.git",
		"directory": "packages/k6"
	},
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"module": "dist/index.js",
	"exports": {
		".": "./dist/index.js"
	},
	"scripts": {
		"build": "tsdown",
		"publish:ci": "pnpm build && pnpm changeset publish",
		"test": "vitest run",
		"test:ci": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@graphql-codegen/plugin-helpers": "^7.4.2",
		"@graphql-codegen/visitor-plugin-common": "7.2.10",
		"auto-bind": "5.0.1"
	},
	"devDependencies": {
		"graphql": "^17.0.2",
		"tsdown": "^0.23.1",
		"tslib": "2.8.1",
		"typescript": "^7.0.2",
		"vitest": "5.0.3"
	},
	"peerDependencies": {
		"graphql": "^16.0.0 || ^17.0.0",
		"graphql-tag": "^2.0.0"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}

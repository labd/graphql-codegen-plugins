{
	"name": "@labdigital/graphql-codegen-bruno",
	"version": "1.3.1",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"types": "./dist/index.d.ts",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/labd/graphql-codegen-plugins.git",
		"directory": "packages/bruno"
	},
	"exports": {
		".": "./dist/index.js"
	},
	"scripts": {
		"build": "tsdown",
		"lint": "biome ci && tsc --noEmit",
		"clean": "rm -rf dist",
		"publish:ci": "pnpm build && pnpm changeset publish",
		"test": "vitest run",
		"test:ci": "vitest run --coverage"
	},
	"dependencies": {
		"@graphql-codegen/plugin-helpers": "^5.0.4"
	},
	"devDependencies": {
		"@graphql-tools/graphql-file-loader": "^8.0.4",
		"@graphql-tools/load": "^8.0.5",
		"@types/node": "^22.20.5",
		"@vitest/coverage-v8": "3.2.7",
		"prettier": "^3.3.3",
		"tsdown": "^0.23.1",
		"typescript": "^5.7.2",
		"vite-tsconfig-paths": "^5.1.3",
		"vitest": "3.2.7"
	},
	"peerDependencies": {
		"graphql": "16.x"
	},
	"pnpm": {
		"overrides": {
			"graphql": "^16.9.0"
		}
	}
}

exports[`k6 plugin > documentMode string > generates the sdk 1`] = `
"import { type RefinedResponse, type ResponseType } from "k6/http";
export class TypedDocumentString<TResult, TVariables> extends String {
  __apiType?: (variables: TVariables) => TResult;
  private value: string;
  public __meta__?: Record<string, any> | undefined;

  constructor(value: string, __meta__?: Record<string, any> | undefined) {
    super(value);
    this.value = value;
    this.__meta__ = __meta__;
  }

  override toString(): string {
    return this.value;
  }
}

export const ProductPriceFragmentDoc = new TypedDocumentString(\`
    fragment ProductPrice on Product {
  price
}
    \`, {"fragmentName":"ProductPrice"});
export const ProductFieldsFragmentDoc = new TypedDocumentString(\`
    fragment ProductFields on Product {
  id
  name
  ...ProductPrice
}
    fragment ProductPrice on Product {
  price
}\`, {"fragmentName":"ProductFields"});
export const GetProductDocument = new TypedDocumentString(\`
    query GetProduct($id: ID!, $locale: Locale) {
  product(id: $id, locale: $locale) {
    ...ProductFields
  }
}
    fragment ProductFields on Product {
  id
  name
  ...ProductPrice
}
fragment ProductPrice on Product {
  price
}\`) as unknown as TypedDocumentString<GetProductQuery, GetProductQueryVariables>;
export const ListProductsDocument = new TypedDocumentString(\`
    query ListProducts($filter: ProductFilter) {
  products(filter: $filter) {
    ...ProductFields
  }
}
    fragment ProductFields on Product {
  id
  name
  ...ProductPrice
}
fragment ProductPrice on Product {
  price
}\`) as unknown as TypedDocumentString<ListProductsQuery, ListProductsQueryVariables>;
export const AddToCartDocument = new TypedDocumentString(\`
    mutation AddToCart($productId: ID!, $quantity: Int!) {
  addToCart(productId: $productId, quantity: $quantity) {
    id
    totalItems
  }
}
    \`) as unknown as TypedDocumentString<AddToCartMutation, AddToCartMutationVariables>;
export const CartUpdatedDocument = new TypedDocumentString(\`
    subscription CartUpdated($cartId: ID!) {
  cartUpdated(cartId: $cartId) {
    id
  }
}
    \`) as unknown as TypedDocumentString<CartUpdatedSubscription, CartUpdatedSubscriptionVariables>;

    export type Requester<C = {}, E = unknown> = <R, V>(doc: TypedDocumentString<R, V>, vars?: V, options?: C) => RefinedResponse<ResponseType>

    export function getSdk<C, E>(requester: Requester<C, E>) {
      return {
            GetProduct(variables: GetProductQueryVariables, options?: C): RefinedResponse<ResponseType> {
              return requester<GetProductQuery, GetProductQueryVariables>(GetProductDocument, variables, options);
            },
    ListProducts(variables?: ListProductsQueryVariables, options?: C): RefinedResponse<ResponseType> {
              return requester<ListProductsQuery, ListProductsQueryVariables>(ListProductsDocument, variables, options);
            },
    AddToCart(variables: AddToCartMutationVariables, options?: C): RefinedResponse<ResponseType> {
              return requester<AddToCartMutation, AddToCartMutationVariables>(AddToCartDocument, variables, options);
            },
    CartUpdated(variables: CartUpdatedSubscriptionVariables, options?: C): RefinedResponse<ResponseType> {
              return requester<CartUpdatedSubscription, CartUpdatedSubscriptionVariables>(CartUpdatedDocument, variables, options);
            }
      };
    }
    export type Sdk = ReturnType<typeof getSdk>;"
`;

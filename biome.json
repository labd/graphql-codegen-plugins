{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"defaultBranch": "main",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!**/dist/**/*"]
	},
	"json": {
		"parser": {
			"allowComments": true
		}
	},
	"formatter": {
		"enabled": true,
		"lineWidth": 80
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noUselessTernary": "error",
				"useDateNow": "error",
				"useLiteralKeys": "off"
			},
			"correctness": {
				"noUnusedFunctionParameters": "off",
				"noUnusedImports": "error",
				"noUnusedVariables": "off"
			},
			"suspicious": {
				"noEvolvingTypes": "error",
				"useErrorMessage": "error",
				"noConsole": {
					"level": "error",
					"options": {
						"allow": ["assert", "debug", "error", "info", "trace", "warn"]
					}
				}
			},
			"style": {
				"noParameterAssign": "off",
				"noUselessElse": "off",
				"useConsistentBuiltinInstantiation": "error",
				"useFilenamingConvention": {
					"level": "error",
					"options": {
						"requireAscii": true,
						"filenameCases": ["kebab-case"]
					}
				},
				"useTemplate": "off",
				"useThrowOnlyError": "error",
				"noNestedTernary": "warn"
			}
		}
	}
}

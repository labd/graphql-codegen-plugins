{
	"name": "@labdigital/graphql-codegen-bruno",
	"version": "1.3.1",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"types": "./dist/index.d.ts",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/labd/graphql-codegen-plugins.git",
		"directory": "packages/bruno"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"clean": "rm -rf dist",
		"lint:package": "publint --strict",
		"publish:ci": "pnpm build && pnpm changeset publish",
		"test": "vitest run",
		"test:ci": "vitest run --coverage",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@graphql-codegen/plugin-helpers": "^7.4.2"
	},
	"devDependencies": {
		"@graphql-tools/graphql-file-loader": "^8.1.22",
		"@graphql-tools/load": "^8.1.19",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "5.0.3",
		"graphql": "^17.0.2",
		"prettier": "^3.9.10",
		"publint": "^0.3.25",
		"tsdown": "^0.23.1",
		"typescript": "^7.0.2",
		"vitest": "5.0.3"
	},
	"peerDependencies": {
		"graphql": "^16.0.0 || ^17.0.0"
	}
}

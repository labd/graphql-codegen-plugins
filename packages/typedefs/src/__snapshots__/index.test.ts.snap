// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`typedefs plugin > generates the typeDefs module 1`] = `
"// This file is automatically generated by @labdigital/graphql-codegen-typedefs
import { gql } from "graphql-tag";

export const typeDefs = gql\`
	extend schema {
		query: Query
		mutation: Mutation
	}

	type Query {
		"""Uses \\\`backticks\\\`"""
		product(id: ID!): Product
	}

	type Mutation {
		addToCart(productId: ID!, quantity: Int!): Cart!
	}

	type Product {
		id: ID!
		name: String!
	}

	type Cart {
		id: ID!
		totalItems: Int!
	}
\`;"
`;
